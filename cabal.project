packages: .

-- These are to support GHC-9.14 and should be dropped once these packages get revisions/new releases.
allow-newer: indexed-traversable:base, indexed-traversable:containers
allow-newer: indexed-traversable-instances:base
allow-newer: aeson:template-haskell, aeson:containers
allow-newer: uuid-types:template-haskell
allow-newer: these:base
allow-newer: semialign:base, semialign:containers
